# Copy to .env and fill in. .env is gitignored and must never be committed.
# Used by `npm run deploy` (scripts/deploy.mjs).
#
# FTP_HOST must be a name the server's TLS certificate actually covers, or the
# connection is refused. Shared hosts often present a certificate for their own
# domain rather than yours: this server answers on ftp.anibalribeiro.cz but
# presents a *.nameserver.sk certificate, so the provider hostname is used.
FTP_HOST=dw373.nameserver.sk
FTP_USER=your-ftp-user
FTP_PASS=your-ftp-password
# Remote web root. Defaults to public_html when unset.
FTP_DIR=public_html
