---
import { getImage } from 'astro:assets';
import photo from '../assets/photo.jpg';
import { origin, site } from '../data/site';
import { canonicalUrl, jsonLdGraph } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  jsonLd?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  preloadHero?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  canonical = canonicalUrl(),
  jsonLd = JSON.stringify(jsonLdGraph()),
  ogImage = `${origin}/og.png`,
  ogImageWidth = '1200',
  ogImageHeight = '630',
  preloadHero = true,
} = Astro.props;

const heroImage = preloadHero
  ? await getImage({
      src: photo,
      width: 160,
      height: 160,
      format: 'webp',
    })
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f4f6f8" />
    <link rel="canonical" href={canonical} />
    {heroImage && <link rel="preload" as="image" href={heroImage.src} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
