---
import { Image } from 'astro:assets';
import icon from '../../assets/pokebattle/icon.png';
import battle from '../../assets/pokebattle/battle.png';
import menu from '../../assets/pokebattle/menu.png';
import dex from '../../assets/pokebattle/pokedex.png';
import won from '../../assets/pokebattle/won.png';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import StoreIcon from '../../components/StoreIcon.astro';
import { pokeBattle } from '../../data/pokeBattle';
import { origin } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import { canonicalUrl } from '../../lib/seo';
import '../../styles/product.css';
const platforms = pokeBattle.stores.map((store) => store.platform);
const shots = [
  { title: 'Pick your move', src: battle, alt: 'Poke Battle on Garmin: Doduo faces Squirtle with HP bars and four moves' },
  { title: 'One more battle', src: menu, alt: 'Poke Battle main menu with New Battle, History, Pokédex and Options' },
  { title: 'Build your Pokédex', src: dex, alt: 'Poke Battle Pokédex showing Squirtle and progress for species seen and beaten' },
  { title: 'Keep your record', src: won, alt: 'Poke Battle victory screen showing Mankey versus Wartortle' },
];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: pokeBattle.name, description: pokeBattle.description,
  url: canonicalUrl('/pokebattle'), operatingSystem: 'Garmin Connect IQ, Zepp OS, watchOS',
  applicationCategory: 'GameApplication', image: `${origin}/pokebattle/icon.png`,
});
---
<Layout title="Poke Battle — Pokémon battles on your Garmin, Zepp OS and Apple Watch" description={pokeBattle.description}
  canonical={canonicalUrl('/pokebattle')} jsonLd={jsonLd}
  ogImage={`${origin}/pokebattle/icon.png`} ogImageWidth="500" ogImageHeight="500" preloadHero={false}>
  <Header slot="header" />
  <article class="product">
    <header class="product-hero">
      <div class="product-brand">
        <Image src={icon} alt="Poke Battle icon" width={96} height={96} class="product-icon" />
        <p class="platform-tags">{platforms.map((platform) => <span class="badge">{platform}</span>)}<span class="badge">Watch game</span></p>
      </div>
      <h1>Poke Battle</h1>
      <p class="lede">The original 151. Four moves. One quick battle on your wrist.</p>
      <p>{pokeBattle.description}</p>
      <div class="cta-row store-buttons" aria-label="Get Poke Battle">
        {pokeBattle.stores.map((store) => store.url
          ? <a class="download" href={store.url}><StoreIcon name={store.icon} />{store.label}</a>
          : <button class="download" type="button" disabled><StoreIcon name={store.icon} />{store.label} · Coming soon</button>)}
        <span class="price-note">${pokeBattle.price} USD</span>
      </div>
      <p class="cta-secondary"><a href="#play">See how it plays</a></p>
    </header>
    <section id="play" aria-labelledby="play-heading">
      <h2 id="play-heading">A little Game Boy on your wrist</h2>
      <p class="section-lede">Start a random matchup, choose a move each turn, and battle until one side faints. Lost a close one? Retry the same matchup.</p>
      <div class="feature-grid">
        {shots.map((shot) => <article>
          <h3>{shot.title}</h3>
          <details class="shot"><summary>
            <Image src={shot.src} alt="" width={280} loading="lazy" />
            <span class="hint-expand">{shot.title} — click to enlarge</span>
            <span class="hint-collapse">{shot.title} — click to collapse</span>
          </summary><Image src={shot.src} alt={shot.alt} width={454} loading="lazy" /></details>
        </article>)}
      </div>
    </section>
    <section aria-labelledby="features-heading">
      <h2 id="features-heading">Short battles, plenty to come back for</h2>
      <ul>
        <li>All 151 original Pokémon, Game Boy-style sprites and classic battle text.</li>
        <li>Four curated moves per Pokémon, modern type matchups, status conditions and a competitive opponent.</li>
        <li>Battle history, a win/loss/draw record and a Pokédex saved on your watch.</li>
        <li>One game, three watch platforms: Garmin Connect IQ watches (including the Forerunner 970), Zepp OS watches and Apple Watch, with touch, buttons or the Digital Crown depending on the watch.</li>
        <li>Offline battles, with no account, advertising or analytics.</li>
      </ul>
    </section>
    <section aria-labelledby="purchase-heading">
      <h2 id="purchase-heading">Get Poke Battle</h2>
      <p>Poke Battle costs ${pokeBattle.price} USD. The Garmin version is available now from the Garmin Store, and Garmin handles the purchase. Applicable taxes and supported devices are shown there before you pay.</p>
      <div class="offer" aria-labelledby="zepp-offer-heading">
        <p class="offer-kicker">Zepp OS · one-time purchase</p>
        <h3 id="zepp-offer-heading">Poke Battle Full Version for Zepp OS — lifetime licence</h3>
        <p class="offer-price"><strong>${pokeBattle.price} USD</strong> once. No subscription, no renewals. Applicable taxes are shown at checkout.</p>
        <p>The Zepp OS version is coming soon. It will be free to download and play as a trial with 3 New Battles a day, reset at midnight. Retrying a matchup, History, the Pokédex and Options are never limited, and a battle you have started always finishes. The full version removes the daily limit.</p>
        <h4>What's included</h4>
        <ul>
          <li>Unlimited New Battles on your Zepp OS watch, with no daily limit.</li>
          <li>A lifetime licence: pay once and keep the full version, including future updates of the Zepp OS app.</li>
          <li>The full game: all 151 original Pokémon, four moves each, battle history, a win/loss/draw record and the Pokédex.</li>
          <li>Activation on one watch, which you can move to another watch later with your licence key and purchase email.</li>
          <li>A licence key delivered straight away on the confirmation page and by email.</li>
          <li>Offline play once activated, with no account, advertising or analytics.</li>
        </ul>
        <h4>How it works</h4>
        <p>Buy the full version {pokeBattle.zeppCheckoutUrl ? <a href={pokeBattle.zeppCheckoutUrl}>through Creem</a> : 'through Creem'}, which handles payment, tax and refunds as merchant of record. You can also open the checkout by scanning the QR code on the watch's Daily Limit screen or from Poke Battle's settings in the Zepp app. Enter your licence key in Poke Battle's settings in the Zepp app to activate your watch. Activation needs a Zepp OS watch paired with the Zepp app and an internet connection.</p>
        <p class="offer-note">The licence covers the Zepp OS version only; the Garmin and Apple Watch versions are sold through their own stores. Refunds and your consumer rights are described in the <a href="/pokebattle/terms/">terms</a>.</p>
        {pokeBattle.zeppCheckoutUrl && <a class="download" href={pokeBattle.zeppCheckoutUrl}>Buy the full version · ${pokeBattle.price} USD</a>}
      </div>
      <p>The Apple Watch version (listed on the App Store as Random PokeBattle) is coming soon. App Store purchases are handled by Apple, and prices in each store can vary by country and tax.</p>
      <p>Already playing? Visit the <a href="/pokebattle/support/">support page</a> for controls and help.</p>
    </section>
    <p class="form-note">An independent fan project. Pokémon and related names and artwork belong to their respective owners, including Nintendo, Game Freak and The Pokémon Company. Poke Battle is not affiliated with or endorsed by them, Garmin, Zepp Health or Apple.</p>
  </article>
  <nav class="product-links" aria-label="Poke Battle links">
    <a href="/pokebattle/privacy/">Privacy</a><a href="/pokebattle/terms/">Terms</a>
    <a href="/pokebattle/support/">Support</a><a href={pokeBattle.supportUrl}>Contact</a>
  </nav>
  <Footer slot="footer" />
</Layout>
<style>
  .feature-grid img { image-rendering: pixelated; }
  .offer { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0; }
  .offer h3 { margin-top: 0.25rem; font-size: 1.15rem; }
  .offer h4 { margin: 1.1rem 0 0.4rem; font-size: 0.95rem; color: var(--text); }
  .offer ul { padding-left: 1.2rem; }
  .offer-kicker { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .offer-price strong { font-size: 1.35rem; color: var(--text); }
  .offer-note { font-size: 0.9rem; color: var(--muted); }
  .product-links { flex-wrap: wrap; }
</style>
