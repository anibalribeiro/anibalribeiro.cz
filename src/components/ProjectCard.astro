---
import { Image } from 'astro:assets';
import type { Project } from '../data/site';
import translatePro from '../assets/projects/translate-pro.png';
import winmice from '../assets/projects/winmice.png';

const icons = {
  'translate-pro': translatePro,
  winmice,
} as const;

interface Props {
  project: Project;
}

const { project } = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);
---
<article>
  <Image
    class="project-icon"
    src={icons[project.icon]}
    alt={`${project.title} icon`}
    width={48}
    height={48}
  />
  <div>
    <h3>{project.title}</h3>
    <p class="tags">{project.tags.join(' · ')}</p>
    <p>{project.description}</p>
    <p class="links">
      <a
        href={project.primary.href}
        {...(isExternal(project.primary.href)
          ? { target: '_blank', rel: 'noopener noreferrer' }
          : {})}
      >
        {project.primary.label}
      </a>
      {
        project.secondary && (
          <a
            href={project.secondary.href}
            {...(isExternal(project.secondary.href)
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            {project.secondary.label}
          </a>
        )
      }
    </p>
  </div>
</article>
