---
import { Image } from 'astro:assets';
import type { Project } from '../data/site';
import fenixRunner from '../assets/projects/fenix-runner.png';
import translatePro from '../assets/projects/translate-pro.png';
import winmice from '../assets/projects/winmice.png';
import pokeBattle from '../assets/pokebattle/icon.png';
import ridge from '../assets/apps/ridge/icon.png';
import pulse from '../assets/apps/pulse/icon.png';
import daylight from '../assets/apps/daylight/icon.png';
import aurora from '../assets/apps/aurora/icon.png';
import footballLive from '../assets/apps/football-live/icon.png';
import miniGolf from '../assets/minigolf/icon-240.png';

const icons = {
  'translate-pro': translatePro,
  winmice,
  pokebattle: pokeBattle,
  'fenix-runner': fenixRunner,
  ridge,
  pulse,
  daylight,
  aurora,
  'football-live': footballLive,
  'minigolf-pro': miniGolf,
} as const;

interface Props {
  project: Project;
}

const { project } = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);

// Each card carries one link: the app's own page on this site when it has one,
// otherwise its store listing.
const links = [project.primary, ...('secondary' in project && project.secondary ? [project.secondary] : [])];
const page =
  links.find((link) => link.label === 'Product site') ??
  links.find((link) => !isExternal(link.href)) ??
  project.primary;
const external = isExternal(page.href);
---
<article class="app-card">
  <Image
    class="project-icon"
    src={icons[project.icon]}
    alt={`${project.title} icon`}
    width={64}
    height={64}
  />
  <div class="app-body">
    <h3>{project.title}</h3>
    <p class="tags">{project.tags.join(' · ')}</p>
    <p>{project.description}</p>
  </div>
  <a class="app-link" href={page.href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{external ? page.label : 'View app'}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
</article>
