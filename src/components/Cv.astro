---
import { site } from '../data/site';
---
<section id="cv" class="panel" aria-labelledby="cv-heading">
  <h2 id="cv-heading">Experience</h2>
  <ol class="roles">
    {
      site.experience.map((role, index) => (
        <li>
          <span
            class:list={['role-mark', { current: index === 0, small: role.mark.length > 1 }]}
            aria-hidden="true"
          >
            {role.mark}
          </span>
          <div class="role-body">
            <div class="role-head">
              <h3>{role.title}</h3>
              <p class:list={['role-dates', { 'current-dates': index === 0 }]}>{role.dates}</p>
            </div>
            <p class="role-org">{role.org}</p>
            {'summary' in role && <p class="role-summary">{role.summary}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</section>
