---
import { site } from '../data/site';
---

<section id="cv" aria-labelledby="cv-heading">
  <h2 id="cv-heading">CV</h2>
  {
    site.cvAvailable ? (
      <article class="cv-card">
        <div class="cv-icon-wrapper" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </svg>
        </div>
        <div class="cv-content">
          <h3>Software Engineering Manager</h3>
          <p class="tags">Engineering Leadership · Platform Architecture</p>
          <p>
            Experience leading distributed backend teams at Workday, scaling enterprise data platforms, and adopting practical AI workflows.
          </p>
          <p class="links">
            <a class="download cv-link" href="/cv/">
              View CV
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </p>
        </div>
      </article>
    ) : (
      <>
        <p>CV coming soon.</p>
        <button class="download" type="button" disabled>
          View CV
        </button>
      </>
    )
  }
</section>
