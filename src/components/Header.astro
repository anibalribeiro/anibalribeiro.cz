---
const home = Astro.url.pathname === '/' || Astro.url.pathname === '';
---
<header id="top">
  <a class="mark" href={home ? '#top' : '/'}>AR</a>
  <nav aria-label="Page">
    {
      home ? (
        <>
          <a href="#work">Work</a>
          <a href="#cv">CV</a>
          <a href="#contact">Contact</a>
        </>
      ) : (
        <>
          <a href="/#work">Work</a>
          <a href="/Winmice/">WinMice</a>
          <a href="/#contact">Contact</a>
        </>
      )
    }
  </nav>
</header>
