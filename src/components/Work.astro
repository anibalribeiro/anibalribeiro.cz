---
import { site } from '../data/site';
import ProjectCard from './ProjectCard.astro';
---
<section id="work" class="panel carousel" aria-labelledby="work-heading">
  <div class="carousel-head">
    <div>
      <h2 id="work-heading">Apps I made</h2>
      <p class="section-note">{site.projects.length} side projects, shipped on my own time.</p>
    </div>
    <div class="carousel-nav" hidden>
      <button type="button" data-dir="-1" aria-label="Previous apps">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
      </button>
      <button type="button" data-dir="1" aria-label="Next apps">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </button>
    </div>
  </div>
  <div class="carousel-track" role="group" aria-label="Apps, scroll sideways for more" tabindex="0">
    {site.projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
<!-- The row scrolls on its own; this only wires up the arrow buttons, which stay hidden without it. -->
<script is:inline>
  (function () {
    var track = document.querySelector('.carousel-track');
    var nav = document.querySelector('.carousel-nav');
    if (!track || !nav) return;
    nav.hidden = false;
    nav.querySelectorAll('button').forEach(function (button) {
      button.addEventListener('click', function () {
        track.scrollBy({
          left: Number(button.dataset.dir) * Math.max(244, track.clientWidth * 0.8),
          behavior: 'smooth',
        });
      });
    });
  })();
</script>
